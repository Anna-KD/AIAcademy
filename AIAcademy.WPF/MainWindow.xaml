<Window x:Class="AIAcademy.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Academy"
        Height="900"
        Width="1200"
        MinHeight="700"
        MinWidth="1000"
        Background="#F5F7FA">

    <Window.Resources>

        <!-- ===== Buttons ===== -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#4F8EF7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <!-- Inactive button appears faded (reflecting CanExecute) -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== TextBox ===== -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>

        <!-- ===== Card (white block) ===== -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E3E8EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Card title -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1E3A5F"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Small field label -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#5B6B7F"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

    </Window.Resources>

    <Grid Margin="14">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== LEFT SIDE ===================== -->
        <Border Grid.Column="0"
                Style="{StaticResource Card}"
                Margin="0,0,14,0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="🤖 Robot Teachers"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#1E3A5F"
                               Margin="0,0,0,14"/>

                    <TextBlock Text="Repository" Style="{StaticResource FieldLabel}"/>

                    <ComboBox Height="32"
                              VerticalContentAlignment="Center"
                              ItemsSource="{Binding Repositories}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedRepository}"/>
                </StackPanel>

                <ListBox Grid.Row="1"
                         Margin="0,12"
                         BorderBrush="#E3E8EF"
                         ItemsSource="{Binding Robots}"
                         SelectedItem="{Binding SelectedRobot}"
                         DisplayMemberPath="Name"
                         FontSize="16"/>

                <StackPanel Grid.Row="2">

                    <TextBlock Text="New robot name" Style="{StaticResource FieldLabel}"/>

                    <TextBox Height="34"
                             FontSize="15"
                             Margin="0,0,0,6"
                             Text="{Binding NewRobotName, UpdateSourceTrigger=PropertyChanged}"/>

                    <Button Content="Add to selected repository"
                            Command="{Binding AddCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== RIGHT SIDE ===================== -->
        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- robot info -->
                <RowDefinition Height="Auto"/>
                <!-- actions -->
                <RowDefinition Height="Auto"/>
                <!-- search + summary -->
                <RowDefinition Height="Auto"/>
                <!-- Vol.3 -->
                <RowDefinition Height="*"/>
                <!-- log -->
            </Grid.RowDefinitions>

            <!-- ===== Robot information ===== -->
            <Border Grid.Row="0" Style="{StaticResource Card}" MinHeight="120">
                <StackPanel>

                    <TextBlock Text="🤖 AI Academy"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#1E3A5F"
                               Margin="0,0,0,4"/>

                    <!-- Hint: shown only when no robot is selected -->
                    <TextBlock Text="← Select a robot from the list"
                               FontStyle="Italic"
                               Foreground="#8A97A8"
                               FontSize="14"
                               Visibility="Collapsed">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedRobot}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Details: hidden when no robot is selected -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedRobot}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <WrapPanel Margin="0,0,0,6">
                            <TextBlock Text="{Binding SelectedRobot.Name, StringFormat=Name: {0}}"
                                       FontSize="16" FontWeight="Bold" Margin="0,0,30,0"/>
                            <TextBlock Text="{Binding SelectedRobot.TypeName, StringFormat=Type: {0}}"
                                       FontSize="16" FontWeight="Bold"/>
                        </WrapPanel>

                        <TextBlock Text="{Binding SelectedRobot.BatteryLevel, StringFormat=Battery: {0}%, Mode=OneWay}"
                                   FontSize="14" Foreground="#5B6B7F" Margin="0,0,0,4"/>

                        <ProgressBar Height="14"
                                     Maximum="100"
                                     Foreground="#2ECC71"
                                     Background="#E8EDF3"
                                     BorderThickness="0"
                                     Value="{Binding SelectedRobot.BatteryLevel, Mode=OneWay}"/>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- ===== Main actions ===== -->
            <Border Grid.Row="1" Style="{StaticResource Card}">
                <WrapPanel>

                    <Button Content="Teach"
                            Width="130"
                            Margin="0,0,10,0"
                            Command="{Binding TeachCommand}"/>

                    <Button Content="Create Quiz"
                            Width="130"
                            Margin="0,0,10,0"
                            Command="{Binding QuizCommand}"/>

                    <Button Content="Recharge"
                            Width="130"
                            Background="#2ECC71"
                            Margin="0,0,10,0"
                            Command="{Binding RechargeCommand}"/>

                    <Button Content="Crazy Action"
                            Width="130"
                            Background="#E74C3C"
                            Margin="0,0,10,0"
                            Command="{Binding CrazyActionCommand}"/>

                    <Button Content="Delete Robot"
                            Width="130"
                            Margin="0"
                            Background="#C0392B"
                            Command="{Binding RemoveCommand}"/>

                </WrapPanel>
            </Border>

            <!-- ===== LINQ: Search, Sorting, Summary ===== -->
            <Border Grid.Row="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Text="Search by name" Style="{StaticResource FieldLabel}"/>

                        <TextBox Height="32"
                                 Margin="0,0,0,8"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                        <Button Content="Sort A-Z"
                                HorizontalAlignment="Left"
                                Width="110"
                                Command="{Binding SortByNameCommand}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Summary (all repositories)" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding SummaryText}"
                                   FontFamily="Consolas"
                                   Foreground="#1E3A5F"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Vol.3 Processing ===== -->
            <Border Grid.Row="3" Style="{StaticResource Card}">
                <StackPanel>

                    <TextBlock Text="🚀 Vol.3 Processing" Style="{StaticResource SectionTitle}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="350"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Workload + buttons -->
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">

                            <TextBlock Text="Workload" Style="{StaticResource FieldLabel}"/>

                            <TextBox Width="150"
                                     Height="32"
                                     HorizontalAlignment="Left"
                                     Margin="0,0,0,12"
                                     Text="{Binding Workload}"/>

                            <WrapPanel>
                                <Button Content="Sequential"
                                        Width="100"
                                        Background="#8E44AD"
                                        Margin="0,0,10,0"
                                        Command="{Binding StartSequentialCommand}"/>

                                <Button Content="Parallel"
                                        Width="100"
                                        Background="#16A085"
                                        Margin="0,0,10,0"
                                        Command="{Binding StartParallelCommand}"/>

                                <Button Content="Cancel"
                                        Width="100"
                                        Margin="0"
                                        Background="#E67E22"
                                        Command="{Binding CancelCommand}"/>
                            </WrapPanel>
                        </StackPanel>

                        <!-- Robot selection -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Select robots for calculation" Style="{StaticResource FieldLabel}"/>

                            <Border BorderBrush="#E3E8EF"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="6">
                                <ScrollViewer Height="90" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding RobotSelections}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Name}"
                                                          IsChecked="{Binding IsSelected}"
                                                          Margin="2"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- ===== Activity Log ===== -->
            <Border Grid.Row="4"
                    Style="{StaticResource Card}"
                    Margin="0"
                    MinHeight="250">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="📋 Activity Log"
                               Style="{StaticResource SectionTitle}"/>

                    <TextBox Grid.Row="1"
                             Text="{Binding LogText, Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             Background="#F8FAFC"
                             Padding="8"
                             FontFamily="Consolas"
                             FontSize="14"/>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>