<Window x:Class="AIAcademy.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Academy"
        Height="650"
        Width="950"
        MinHeight="550"
        MinWidth="800"
        Background="#F5F7FA">

    <Window.Resources>
        <!-- One style for all buttons -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#4F8EF7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- An inactive button appears gray (reflecting CanExecute) -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== LEFT SIDE ===== -->
        <Grid Grid.Column="0" Margin="0,0,10,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="🤖 Robot Teachers"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <TextBlock Text="Repository:" FontWeight="Bold" Margin="0,0,0,5"/>

                <ComboBox ItemsSource="{Binding Repositories}"
                          DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedRepository}"/>
            </StackPanel>

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Robots}"
                     SelectedItem="{Binding SelectedRobot}"
                     DisplayMemberPath="Name"
                     FontSize="16"/>

            <StackPanel Grid.Row="2" Margin="0,10,0,0">

                <TextBlock Text="New Robot Name:"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                <TextBox Height="30"
                         FontSize="15"
                         Margin="0,0,0,5"
                         Text="{Binding NewRobotName, UpdateSourceTrigger=PropertyChanged}"/>

                <Button Content="Add to selected repository"
                        Command="{Binding AddCommand}"/>

            </StackPanel>
        </Grid>

        <!-- ===== RIGHT SIDE ===== -->
        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Information about the robot -->
            <StackPanel Grid.Row="0">

                <TextBlock Text="🤖 AI Academy"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#1E3A5F"
                           Margin="0,0,0,10"/>

                <TextBlock Text="{Binding SelectedRobot.Name, StringFormat=Name: {0}}"
                           FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>

                <TextBlock Text="{Binding SelectedRobot.TypeName, StringFormat=Type: {0}}"
                           FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                <TextBlock Text="{Binding SelectedRobot.BatteryLevel, StringFormat=Battery: {0}%, Mode=OneWay}"
                           FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>

                <ProgressBar Height="20" Maximum="100"
                             Value="{Binding SelectedRobot.BatteryLevel, Mode=OneWay}"/>

            </StackPanel>

            <!-- Main actions -->
            <WrapPanel Grid.Row="1" Margin="0,15">

                <Button Content="Teach"
                        Width="130"
                        Margin="0,0,10,0"
                        Command="{Binding TeachCommand}"/>

                <Button Content="Create Quiz"
                        Width="130"
                        Margin="0,0,10,0"
                        Command="{Binding QuizCommand}"/>

                <Button Content="Recharge"
                        Width="130"
                        Background="#2ECC71"
                        Margin="0,0,10,0"
                        Command="{Binding RechargeCommand}"/>

                <Button Content="Crazy Action"
                        Width="130"
                        Background="#E74C3C"
                        Margin="0,0,10,0"
                        Command="{Binding CrazyActionCommand}"/>

                <Button Content="Delete Robot"
                        Width="130"
                        Background="#C0392B"
                        Command="{Binding RemoveCommand}"/>

            </WrapPanel>

            <!-- LINQ: Search, Sorting, Summary -->
            <StackPanel Grid.Row="2" Margin="0,0,0,10">

                <TextBlock Text="Search by name:" FontWeight="Bold" Margin="0,0,0,5"/>

                <WrapPanel>
                    <TextBox Width="180" Height="30" Margin="0,0,10,0"
             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                    <Button Content="Sort A-Z" Width="110" Margin="0,0,10,0"
            Command="{Binding SortByNameCommand}"/>


                </WrapPanel>

                <TextBlock Text="Summary (all repositories):" FontWeight="Bold" Margin="0,10,0,3"/>
                <TextBlock Text="{Binding SummaryText}" FontFamily="Consolas"/>

            </StackPanel>

            <!-- Activity Log -->
            <GroupBox Grid.Row="3" Header="📋 Activity Log">

                <TextBox Text="{Binding LogText, Mode=OneWay}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="14"/>

            </GroupBox>

        </Grid>

    </Grid>
</Window>