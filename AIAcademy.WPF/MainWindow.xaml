<Window x:Class="AIAcademy.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Academy"
        Height="650"
        Width="950"
        MinHeight="550"
        MinWidth="800"
        Background="#F5F7FA">

    <Window.Resources>
        <!-- Один стиль для всех кнопок: цвет, скругление, размер -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#4F8EF7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">

        <!-- Две колонки: слева список, справа всё остальное -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== ЛЕВАЯ ЧАСТЬ ===== -->
        <Grid Grid.Column="0" Margin="0,0,10,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- заголовок -->
                <RowDefinition Height="*"/>
                <!-- список растягивается -->
                <RowDefinition Height="Auto"/>
                <!-- добавление робота -->
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="🤖 Robot Teachers"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <ListBox Grid.Row="1"
                     x:Name="RobotListBox"
                     ItemsSource="{Binding Robots}"
                     DisplayMemberPath="Name"
                     FontSize="16"/>

            <StackPanel Grid.Row="2" Margin="0,10,0,0">

                <TextBlock Text="New Robot Name:"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="RobotNameTextBox"
                         Height="30"
                         FontSize="15"
                         Margin="0,0,0,5"/>

                <Button Content="Add Math Teacher"
                        Click="AddMathRobotButton_Click"/>

                <Button Content="Add Language Teacher"
                        Click="AddLanguageRobotButton_Click"/>

                <Button Content="Add Science Teacher"
                        Click="AddScienceRobotButton_Click"/>

                <Button Content="Add History Teacher"
                        Click="AddHistoryRobotButton_Click"/>

            </StackPanel>
        </Grid>

        <!-- ===== ПРАВАЯ ЧАСТЬ ===== -->
        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Информация о роботе -->
            <StackPanel Grid.Row="0">

                <TextBlock Text="🤖 AI Academy"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="#1E3A5F"
                   Margin="0,0,0,10"/>

                <TextBlock x:Name="NameTextBlock"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,0,0,5"/>

                <TextBlock x:Name="TypeTextBlock"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

                <TextBlock x:Name="BatteryTextBlock"
                   Text="Battery: 100%"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,0,0,5"/>

                <ProgressBar x:Name="BatteryProgressBar"
                     Height="20"
                     Maximum="100"
                     Value="100"/>

            </StackPanel>

            <!-- Основные действия -->
            <WrapPanel Grid.Row="1" Margin="0,15">

                <Button Content="Teach"
                Width="130"
                Margin="0,0,10,0"
                Click="TeachButton_Click"/>

                <Button Content="Create Quiz"
                Width="130"
                Margin="0,0,10,0"
                Click="QuizButton_Click"/>

                <Button Content="Recharge"
                Width="130"
                Background="#2ECC71"
                Margin="0,0,10,0"
                Click="RechargeButton_Click"/>

                <Button Content="Crazy Action"
                Width="130"
                Background="#E74C3C"
                Margin="0,0,10,0"
                Click="CrazyActionButton_Click"/>

                <Button Content="Delete Robot"
                Width="130"
                Background="#C0392B"
                Click="DeleteRobotButton_Click"/>

            </WrapPanel>

            <!-- LINQ -->
            <StackPanel Grid.Row="2"
                Margin="0,0,0,10">

                <TextBlock Text="Search Robot:"
                   FontWeight="Bold"
                   Margin="0,0,0,5"/>

                <WrapPanel>

                    <TextBox x:Name="SearchTextBox"
                     Width="180"
                     Height="30"
                     Margin="0,0,10,0"/>

                    <Button Content="Search"
                    Width="100"
                    Click="SearchButton_Click"/>

                    <Button Content="Sort A-Z"
                    Width="100"
                    Margin="10,0,0,0"
                    Click="SortButton_Click"/>

                    <Button Content="Show Summary"
        Width="130"
        Margin="10,0,0,0"
        Command="{Binding SummaryCommand}"/>
                    
                    <Button Content="Test MVVM"
        Width="120"
        Margin="10,0,0,0"
        Command="{Binding TestCommand}"/>
                    <Button Content="Test CanExecute"
        Width="140"
        Command="{Binding TestCanExecuteCommand}" />
                 

                </WrapPanel>

            </StackPanel>

            <!-- Лог -->
            <GroupBox Grid.Row="3"
              Header="📋 Activity Log">

                <TextBox x:Name="LogTextBox"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="14"/>

            </GroupBox>

        </Grid>

    </Grid>
</Window>